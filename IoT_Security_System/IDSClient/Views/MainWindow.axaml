<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IDSClient.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="IDSClient.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="IoT SENTRY - Military Grade IDS"
        TransparencyLevelHint="AcrylicBlur"
        Background="#1E1E2E"
        ExtendClientAreaToDecorationsHint="True"
        MinWidth="800" MinHeight="500">

	<Design.DataContext>
		<vm:MainViewModel/>
	</Design.DataContext>

	<Window.Styles>
		<Style Selector="Button.NavButton">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="#89B4FA"/>
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="Padding" Value="15,10"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="8"/>
		</Style>
		
		<Style Selector="Button.NavButton:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#313244"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="60, *">
		
		<Border Grid.Row="0" Background="#181825" Padding="20,0">
			<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
				<PathIcon Data="{StaticResource shield_regular}" Foreground="#89B4FA" Width="25" Height="25"/>
				<TextBlock Text="IoT SENTRY" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
				<Border Background="{Binding StatusColor}" CornerRadius="10" Padding="10,2" Margin="20,0,0,0">
					<TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
				</Border>
			</StackPanel>
		</Border>

		<Grid Grid.Row="1" ColumnDefinitions="260, *" Margin="20">
			
			<ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,15,0">
				<StackPanel Spacing="20">
					
					<StackPanel Spacing="5" Margin="0,0,0,10">
						<TextBlock Text="MENU" Foreground="#585B70" FontSize="12" FontWeight="Bold" Margin="5,0,0,5"/>
						
						<Button Classes="NavButton" Command="{Binding GoToDashboardCommand}">
							<StackPanel Orientation="Horizontal" Spacing="10">
								<PathIcon Data="{StaticResource home_regular}" Width="16" Height="16"/>
								<TextBlock Text="Dashboard"/>
							</StackPanel>
						</Button>

						<Button Classes="NavButton" Command="{Binding GoToLiveFeedCommand}">
							<StackPanel Orientation="Horizontal" Spacing="10">
								<PathIcon Data="{StaticResource globe_regular}" Width="16" Height="16"/>
								<TextBlock Text="Live Feed"/>
							</StackPanel>
						</Button>

						<Button Classes="NavButton" Command="{Binding GoToHistoryCommand}">
							<StackPanel Orientation="Horizontal" Spacing="10">
								<PathIcon Data="{StaticResource text_bullet_list_square_regular}" Width="16" Height="16"/>
								<TextBlock Text="History Logs"/>
							</StackPanel>
						</Button>
					</StackPanel>

					<Border Background="#313244" CornerRadius="10" Padding="15">
						<StackPanel Spacing="15">
							<TextBlock Text="Connection Settings" Foreground="White" FontWeight="Bold" FontSize="16"/>
							
							<StackPanel>
								<TextBlock Text="Server IP" Foreground="#A6ADC8" Margin="0,0,0,5"/>
								<TextBox Text="{Binding ServerIp}" Background="#45475A" Foreground="White"/>
							</StackPanel>
							<StackPanel>
								<TextBlock Text="Port" Foreground="#A6ADC8" Margin="0,0,0,5"/>
								<TextBox Text="{Binding ServerPort}" Background="#45475A" Foreground="White"/>
							</StackPanel>
							<StackPanel>
								<TextBlock Text="Secret Key" Foreground="#A6ADC8" Margin="0,0,0,5"/>
								<TextBox Text="{Binding SecretKey}" PasswordChar="•" Background="#45475A" Foreground="White"/>
							</StackPanel>
							<StackPanel>
								<TextBlock Text="Interface" Foreground="#A6ADC8" Margin="0,0,0,5"/>
								<ComboBox ItemsSource="{Binding AvailableInterfaces}" SelectedItem="{Binding InterfaceName}" 
                                          HorizontalAlignment="Stretch" Background="#45475A" Foreground="White"/>
							</StackPanel>
							<Grid ColumnDefinitions="*, 10, *">
								<Button Grid.Column="0" Command="{Binding ConnectSystemCommand}" Content="Connect" 
                                        Background="#89B4FA" Foreground="#1E1E2E" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
								<Button Grid.Column="2" Command="{Binding DisconnectSystemCommand}" Content="Stop" 
                                        Background="#45475A" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
							</Grid>
						</StackPanel>
					</Border>
				</StackPanel>
			</ScrollViewer>

			<TabControl Grid.Column="1" SelectedIndex="{Binding CurrentTabIndex}" Margin="10,0,0,0">
				<TabControl.Styles>
					<Style Selector="TabItem">
						<Setter Property="IsVisible" Value="False"/> <Setter Property="Padding" Value="0"/>
						<Setter Property="Margin" Value="0"/>
						<Setter Property="MinHeight" Value="0"/>
					</Style>
				</TabControl.Styles>

				<TabItem>
					<Grid RowDefinitions="Auto, *">
						<Grid Grid.Row="0" ColumnDefinitions="*, 20, *" MinHeight="100">
							
							<Button Grid.Column="0" Command="{Binding GoToHistoryCommand}" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
								<Border Background="{Binding ThreatColor}" CornerRadius="10" Padding="15">
									<StackPanel VerticalAlignment="Center">
										<StackPanel Orientation="Horizontal" Spacing="5">
											<TextBlock Text="Active Threats" Foreground="White" Opacity="0.8"/>
											<TextBlock Text="↗" Foreground="White" Opacity="0.5" FontSize="12"/>
										</StackPanel>
										<Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Height="40">
											<TextBlock Text="{Binding ThreatCount}" FontSize="32" FontWeight="Bold" Foreground="White"/>
										</Viewbox>
										<TextBlock Text="{Binding ThreatStatus}" Foreground="White" FontSize="14" TextWrapping="Wrap" Margin="0,5,0,0"/>
									</StackPanel>
								</Border>
							</Button>

							<Border Grid.Column="2" Background="#313244" CornerRadius="10" Padding="15">
								<StackPanel VerticalAlignment="Center">
									<TextBlock Text="Packets/Sec" Foreground="#A6ADC8"/>
									<Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Height="40">
										<TextBlock Text="{Binding PacketsPerSecond}" FontSize="32" FontWeight="Bold" Foreground="White"/>
									</Viewbox>
								</StackPanel>
							</Border>
						</Grid>

						<Border Grid.Row="1" Background="Black" CornerRadius="10" Margin="0,20,0,0" Padding="15">
							<Grid RowDefinitions="Auto, *">
								<TextBlock Grid.Row="0" Text=">_ SYSTEM TERMINAL (PREVIEW)" Foreground="#00FF00" FontFamily="Consolas" Margin="0,0,0,10"/>
								<ListBox Grid.Row="1" ItemsSource="{Binding LiveLogs}" Background="Transparent" Foreground="#00FF00" FontFamily="Consolas">
									<ListBox.Styles>
										<Style Selector="ListBoxItem">
											<Setter Property="Padding" Value="0"/>
											<Setter Property="Margin" Value="0,2"/>
										</Style>
									</ListBox.Styles>
								</ListBox>
							</Grid>
						</Border>
					</Grid>
				</TabItem>

				<TabItem>
					<Grid RowDefinitions="Auto, *">
						<StackPanel Orientation="Horizontal" Margin="0,0,0,20" Spacing="10">
							<TextBlock Text="Threat History Log" FontSize="24" FontWeight="Bold" Foreground="White"/>
						</StackPanel>
						
						<ScrollViewer Grid.Row="1">
							<ItemsControl ItemsSource="{Binding HistoryLogs}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Expander Margin="0,0,0,10" Background="#313244" CornerRadius="5">
											<Expander.Header>
												<Grid ColumnDefinitions="80, 80, *">
													<TextBlock Text="{Binding Time}" Foreground="#A6ADC8" VerticalAlignment="Center"/>
													<Border Grid.Column="1" Background="{Binding Color}" CornerRadius="5" Padding="5,2" HorizontalAlignment="Left" MinWidth="60">
														<TextBlock Text="{Binding Level}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
													</Border>
													<TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="White" TextTrimming="CharacterEllipsis" Margin="15,0,0,0" VerticalAlignment="Center"/>
												</Grid>
											</Expander.Header>
											<StackPanel Margin="10">
												<TextBlock Text="THREAT REPORT DETAILS" Foreground="#89B4FA" FontWeight="Bold" Margin="0,0,0,5"/>
												<TextBlock Text="{Binding Message}" Foreground="White" TextWrapping="Wrap" FontSize="14"/>
												<TextBlock Text="Analysis: Traffic patterns suggest anomalous behavior consistent with flooding or probing." Foreground="#A6ADC8" Margin="0,10,0,0" FontStyle="Italic"/>
											</StackPanel>
										</Expander>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</Grid>
				</TabItem>

				<TabItem>
					<Grid RowDefinitions="Auto, *">
						<TextBlock Grid.Row="0" Text="LIVE TRAFFIC FEED (FULL STREAM)" Foreground="#89B4FA" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>
						
						<Border Grid.Row="1" Background="Black" CornerRadius="10" Padding="15">
							<Grid RowDefinitions="Auto, *">
								<TextBlock Grid.Row="0" Text=">_ LISTENING ON INTERFACE..." Foreground="#00FF00" FontFamily="Consolas" Margin="0,0,0,10"/>
								<ListBox Grid.Row="1" ItemsSource="{Binding LiveLogs}" Background="Transparent" Foreground="#00FF00" FontFamily="Consolas">
									<ListBox.Styles>
										<Style Selector="ListBoxItem">
											<Setter Property="Padding" Value="0"/>
											<Setter Property="Margin" Value="0,2"/>
										</Style>
									</ListBox.Styles>
								</ListBox>
							</Grid>
						</Border>
					</Grid>
				</TabItem>

			</TabControl>
		</Grid>
	</Grid>
</Window>